<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OeXYZ Console Client</AssemblyName>
    <RootNamespace>OeXYZ.ConsoleClient</RootNamespace>
    <ApplicationIcon>..\..\assets\oexyz.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
    <Authors>OeXYZ contributors</Authors>
    <Product>OeXYZ Console Client</Product>
    <Description>Native headless Minecraft Java console client for chat and AFK sessions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Oexyz/OeXYZ-Minecraft-Console-Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Oexyz/OeXYZ-Minecraft-Console-Client</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OeXYZ.Core\OeXYZ.Core.csproj" />
    <ProjectReference Include="..\OeXYZ.Protocol\OeXYZ.Protocol.csproj" />
    <ProjectReference Include="..\OeXYZ.Updater\OeXYZ.Updater.csproj" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
  </ItemGroup>
</Project>
