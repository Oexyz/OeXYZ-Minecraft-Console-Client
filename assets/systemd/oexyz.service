[Unit]
Description=OeXYZ Minecraft Console Client headless supervisor
Documentation=https://github.com/Oexyz/OeXYZ-Minecraft-Console-Client
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/oexyz supervise --config %h/.config/oexyz/profiles.json --no-input --account-key-file %h/.config/oexyz/account.key --health-port 8765
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=2 3 4 6 64
TimeoutStopSec=30s
WatchdogSec=30s
UMask=0077
Environment=DOTNET_EnableDiagnostics=0
EnvironmentFile=-%h/.config/oexyz/service.env
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
TasksMax=128
LimitNOFILE=4096
ReadWritePaths=-%h/.config/oexyz -%h/.local/state/oexyz

[Install]
WantedBy=default.target
